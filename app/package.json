{
  "name": "reality-loop-app",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic vertical shorts - Remotion + Three.js",
  "scripts": {
    "start": "remotion studio --port=3000",
    "studio": "remotion studio --port=3000",
    "typecheck": "tsc",
    "still": "remotion still src/index.ts e02-the-rep-report",
    "qa": "remotion render src/index.ts e02-the-rep-report ../out/qa/seq --sequence --image-format=png --scale=0.25 --log=error",
    "render": "remotion render src/index.ts e01-the-wheel out/e01-the-wheel.mp4",
    "render-1080": "remotion render src/index.ts e02-the-rep-report ../out/e02-the-rep-report-1080.mp4 --video-bitrate=8M --log=error",
    "render-4k": "remotion render src/index.ts e02-the-rep-report ../out/e02-the-rep-report-4k.mp4 --scale=2 --video-bitrate=24M --log=error"
  },
  "dependencies": {
    "@react-three/fiber": "^8.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
